diff --git a/component/fragment/option.go b/component/fragment/option.go
new file mode 100644
index 0000000..634b4f8
--- /dev/null
+++ b/component/fragment/option.go
@@ -0,0 +1,140 @@
+// Copyright (C) 2026 mateika8814 (https://github.com/mateika8814)
+// This file is part of allah-verge (fork of Clash Verge Rev / mihomo).
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+
+package fragment
+
+import (
+	"math/rand"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+)
+
+type Mode string
+
+const (
+	ModeSNI            Mode = "sni"
+	ModeRandom         Mode = "random"
+	ModeRecordFragment Mode = "record_fragment"
+	ModeBoth           Mode = "both"
+)
+
+// Option defines the fragment configuration per proxy node
+type Option struct {
+	Enabled        bool          `proxy:"enabled,omitempty" yaml:"enabled,omitempty" json:"enabled,omitempty"`
+	Mode           Mode          `proxy:"mode,omitempty" yaml:"mode,omitempty" json:"mode,omitempty"`
+	Length         string        `proxy:"length,omitempty" yaml:"length,omitempty" json:"length,omitempty"`
+	Interval       string        `proxy:"interval,omitempty" yaml:"interval,omitempty" json:"interval,omitempty"`
+	RecordFragment bool          `proxy:"record-fragment,omitempty" yaml:"record-fragment,omitempty" json:"record-fragment,omitempty"`
+	BufferTimeout  time.Duration `proxy:"-" yaml:"-" json:"-"`
+}
+
+func (o *Option) GetMode() Mode {
+	if o == nil || o.Mode == "" {
+		return ModeSNI
+	}
+	m := strings.ToLower(strings.TrimSpace(string(o.Mode)))
+	switch m {
+	case "sni":
+		return ModeSNI
+	case "random":
+		return ModeRandom
+	case "record_fragment", "record-fragment":
+		return ModeRecordFragment
+	case "both":
+		return ModeBoth
+	default:
+		log.Warnln("[Fragment] unknown fragmentation mode '%s', falling back to 'sni'", o.Mode)
+		return ModeSNI
+	}
+}
+
+// IsRecordFragment returns whether TLS record splitting should be performed.
+// Conflict resolution:
+// If record-fragment: true is specified with mode: sni or mode: random,
+// record-fragment takes precedence and enables record splitting.
+func (o *Option) IsRecordFragment() bool {
+	if o == nil {
+		return false
+	}
+	m := o.GetMode()
+	return o.RecordFragment || m == ModeRecordFragment || m == ModeBoth
+}
+
+func (o *Option) ParseLength(defMin, defMax int) (int, int) {
+	if o == nil || o.Length == "" {
+		return defMin, defMax
+	}
+	return parseRange(o.Length, defMin, defMax, false)
+}
+
+func (o *Option) IntervalRange(defMin, defMax int) (int, int) {
+	if o == nil || o.Interval == "" {
+		return defMin, defMax
+	}
+	return parseRange(o.Interval, defMin, defMax, true)
+}
+
+func (o *Option) RandomInterval(min, max int) time.Duration {
+	if min <= 0 && max <= 0 {
+		return 0
+	}
+	ms := randomBetween(min, max)
+	if ms <= 0 {
+		return 0
+	}
+	return time.Duration(ms) * time.Millisecond
+}
+
+func (o *Option) ParseInterval(defMin, defMax int) time.Duration {
+	min, max := o.IntervalRange(defMin, defMax)
+	return o.RandomInterval(min, max)
+}
+
+func (o *Option) GetBufferTimeout() time.Duration {
+	if o != nil && o.BufferTimeout > 0 {
+		return o.BufferTimeout
+	}
+	return 2 * time.Second
+}
+
+func parseRange(s string, defMin, defMax int, allowZero bool) (int, int) {
+	if s == "" {
+		return defMin, defMax
+	}
+	minBound := 1
+	if allowZero {
+		minBound = 0
+	}
+	parts := strings.Split(s, "-")
+	if len(parts) == 1 {
+		v, err := strconv.Atoi(strings.TrimSpace(parts[0]))
+		if err != nil || v < minBound {
+			return defMin, defMax
+		}
+		return v, v
+	}
+	v1, err1 := strconv.Atoi(strings.TrimSpace(parts[0]))
+	v2, err2 := strconv.Atoi(strings.TrimSpace(parts[1]))
+	if err1 != nil || err2 != nil || v1 < minBound || v2 < minBound {
+		return defMin, defMax
+	}
+	if v1 > v2 {
+		v1, v2 = v2, v1
+	}
+	return v1, v2
+}
+
+func randomBetween(min, max int) int {
+	if min >= max {
+		return min
+	}
+	return min + rand.Intn(max-min+1)
+}
diff --git a/component/fragment/sni.go b/component/fragment/sni.go
new file mode 100644
index 0000000..e2ffc1d
--- /dev/null
+++ b/component/fragment/sni.go
@@ -0,0 +1,142 @@
+// Copyright (C) 2026 mateika8814 (https://github.com/mateika8814)
+// This file is part of allah-verge (fork of Clash Verge Rev / mihomo).
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+
+package fragment
+
+import (
+	"encoding/binary"
+	"strings"
+)
+
+// FindSNIOffset parses a TLS ClientHello record to find the exact byte offset
+// and length of the server_name host in the record buffer.
+// It returns (offset, length, true) if found, or (0, 0, false) if not found or on parse failure.
+func FindSNIOffset(b []byte) (offset int, length int, ok bool) {
+	// A minimum TLS ClientHello record is at least 44 bytes
+	if len(b) < 44 {
+		return 0, 0, false
+	}
+
+	// Must be a TLS Handshake record (0x16) with major version 0x03
+	if b[0] != 0x16 || b[1] != 0x03 {
+		return 0, 0, false
+	}
+
+	recLen := int(binary.BigEndian.Uint16(b[3:5]))
+	if len(b) < 5+recLen {
+		return 0, 0, false
+	}
+
+	// Handshake Message starts at offset 5
+	// Handshake type: 0x01 = ClientHello
+	if b[5] != 0x01 {
+		return 0, 0, false
+	}
+
+	// Handshake length (3 bytes)
+	hsLen := int(b[6])<<16 | int(b[7])<<8 | int(b[8])
+	if hsLen < 38 || len(b) < 5+4+hsLen {
+		return 0, 0, false
+	}
+
+	// ClientVersion (2 bytes) + Random (32 bytes) = 34 bytes
+	// Offset of SessionID length: 5 + 4 + 34 = 43
+	p := 43
+	if len(b) < p+1 {
+		return 0, 0, false
+	}
+	sidLen := int(b[p])
+	p += 1 + sidLen
+
+	// CipherSuites: 2 bytes length + data
+	if len(b) < p+2 {
+		return 0, 0, false
+	}
+	csLen := int(binary.BigEndian.Uint16(b[p : p+2]))
+	p += 2 + csLen
+
+	// CompressionMethods: 1 byte length + data
+	if len(b) < p+1 {
+		return 0, 0, false
+	}
+	cmLen := int(b[p])
+	p += 1 + cmLen
+
+	// Extensions: 2 bytes length + extensions
+	if len(b) < p+2 {
+		return 0, 0, false
+	}
+	extsLen := int(binary.BigEndian.Uint16(b[p : p+2]))
+	p += 2
+	endExts := p + extsLen
+	if endExts > len(b) {
+		endExts = len(b)
+	}
+
+	// Traverse extensions
+	for p+4 <= endExts {
+		extType := binary.BigEndian.Uint16(b[p : p+2])
+		extLen := int(binary.BigEndian.Uint16(b[p+2 : p+4]))
+		p += 4
+
+		if p+extLen > endExts {
+			return 0, 0, false
+		}
+
+		if extType == 0x0000 { // Server Name Indication (SNI)
+			sniData := b[p : p+extLen]
+			// SNI list length (2 bytes) + name type (1 byte) + name length (2 bytes)
+			if len(sniData) >= 5 && sniData[2] == 0x00 { // 0x00 = host_name
+				hostLen := int(binary.BigEndian.Uint16(sniData[3:5]))
+				if hostLen > 0 && len(sniData) >= 5+hostLen {
+					hostOffset := p + 5
+					return hostOffset, hostLen, true
+				}
+			}
+		}
+
+		p += extLen
+	}
+
+	return 0, 0, false
+}
+
+// ExtractSNI extracts the server_name (SNI) string from a TLS ClientHello record if present.
+func ExtractSNI(b []byte) string {
+	offset, length, ok := FindSNIOffset(b)
+	if ok && offset >= 0 && offset+length <= len(b) {
+		return string(b[offset : offset+length])
+	}
+	return ""
+}
+
+// MaskDomain masks sensitive middle parts of a domain name to protect user privacy in logs.
+// e.g. "youtube.com" -> "y***e.com", "api.github.com" -> "***.g***b.com".
+func MaskDomain(d string) string {
+	if len(d) == 0 {
+		return ""
+	}
+	parts := strings.Split(d, ".")
+	if len(parts) >= 2 {
+		mainIdx := len(parts) - 2
+		main := parts[mainIdx]
+		if len(main) <= 2 {
+			parts[mainIdx] = "**"
+		} else {
+			parts[mainIdx] = string(main[0]) + "***" + string(main[len(main)-1])
+		}
+		for i := 0; i < mainIdx; i++ {
+			parts[i] = "***"
+		}
+		return strings.Join(parts, ".")
+	}
+	if len(d) <= 2 {
+		return "**"
+	}
+	return string(d[0]) + "***" + string(d[len(d)-1])
+}
diff --git a/component/fragment/sni_test.go b/component/fragment/sni_test.go
new file mode 100644
index 0000000..53423ca
--- /dev/null
+++ b/component/fragment/sni_test.go
@@ -0,0 +1,135 @@
+// Copyright (C) 2026 mateika8814 (https://github.com/mateika8814)
+// This file is part of allah-verge (fork of Clash Verge Rev / mihomo).
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+
+package fragment
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+// Helper to construct a synthetic but RFC-compliant TLS ClientHello
+func makeClientHello(sni string, includeSNI bool) []byte {
+	var exts []byte
+	if includeSNI {
+		sniBytes := []byte(sni)
+		sniExt := []byte{0x00, 0x00} // extension type 0 = server_name
+		sniExt = binary.BigEndian.AppendUint16(sniExt, uint16(len(sniBytes)+5))
+		sniExt = binary.BigEndian.AppendUint16(sniExt, uint16(len(sniBytes)+3))
+		sniExt = append(sniExt, 0x00) // name_type 0 = host_name
+		sniExt = binary.BigEndian.AppendUint16(sniExt, uint16(len(sniBytes)))
+		sniExt = append(sniExt, sniBytes...)
+		exts = sniExt
+	} else {
+		// ALPN or dummy extension (e.g. type 0x0010)
+		dummy := []byte{0x00, 0x10, 0x00, 0x02, 0x01, 0x02}
+		exts = dummy
+	}
+
+	hsPayload := []byte{0x03, 0x03}                       // ClientVersion TLS 1.2
+	hsPayload = append(hsPayload, make([]byte, 32)...)    // Random (32 bytes)
+	hsPayload = append(hsPayload, 0x00)                   // SessionID length 0
+	hsPayload = append(hsPayload, 0x00, 0x02, 0x00, 0x9c) // CipherSuites: 1 suite (0x009c)
+	hsPayload = append(hsPayload, 0x01, 0x00)             // CompressionMethods: 1 method (null)
+	hsPayload = binary.BigEndian.AppendUint16(hsPayload, uint16(len(exts)))
+	hsPayload = append(hsPayload, exts...)
+
+	hs := []byte{0x01} // HandshakeType ClientHello
+	hsLen := len(hsPayload)
+	hs = append(hs, byte(hsLen>>16), byte(hsLen>>8), byte(hsLen))
+	hs = append(hs, hsPayload...)
+
+	rec := []byte{0x16, 0x03, 0x01} // Record header: Handshake, TLS 1.0 legacy
+	rec = binary.BigEndian.AppendUint16(rec, uint16(len(hs)))
+	rec = append(rec, hs...)
+	return rec
+}
+
+func TestFindSNIOffset_Valid(t *testing.T) {
+	testDomains := []string{
+		"example.com",
+		"subdomain.target.org",
+		"a.b.c.d.ru",
+		"very-long-domain-name-for-testing-purposes-12345.net",
+	}
+
+	for _, domain := range testDomains {
+		pkt := makeClientHello(domain, true)
+		offset, length, ok := FindSNIOffset(pkt)
+		if !ok {
+			t.Fatalf("Expected SNI to be found for domain %s", domain)
+		}
+		if length != len(domain) {
+			t.Fatalf("Expected length %d, got %d", len(domain), length)
+		}
+		extracted := string(pkt[offset : offset+length])
+		if extracted != domain {
+			t.Fatalf("Extracted domain %s != expected %s", extracted, domain)
+		}
+	}
+}
+
+func TestFindSNIOffset_WithoutSNI(t *testing.T) {
+	pkt := makeClientHello("", false)
+	_, _, ok := FindSNIOffset(pkt)
+	if ok {
+		t.Fatalf("Expected FindSNIOffset to return ok=false when SNI is absent")
+	}
+}
+
+func TestFindSNIOffset_Truncated(t *testing.T) {
+	pkt := makeClientHello("example.com", true)
+
+	// Test cutting at every single byte boundary
+	for i := 0; i < len(pkt)-1; i++ {
+		truncated := pkt[:i]
+		_, _, ok := FindSNIOffset(truncated)
+		if ok {
+			t.Fatalf("Expected ok=false for truncated packet at len %d (original %d)", i, len(pkt))
+		}
+	}
+}
+
+func TestFindSNIOffset_Garbage(t *testing.T) {
+	garbageCases := [][]byte{
+		nil,
+		{},
+		{0x00, 0x01, 0x02},
+		[]byte("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n"),
+		[]byte("SSH-2.0-OpenSSH_8.9p1\r\n"),
+		make([]byte, 100), // all zeros
+		{0x16, 0x03, 0x01, 0xFF, 0xFF}, // fake record header with truncated payload
+		{0x16, 0x03, 0x01, 0x00, 0x05, 0x02, 0x00, 0x00, 0x01, 0x00}, // Handshake type 2 (ServerHello, not ClientHello)
+	}
+
+	for idx, g := range garbageCases {
+		_, _, ok := FindSNIOffset(g)
+		if ok {
+			t.Fatalf("Expected ok=false on garbage case %d", idx)
+		}
+	}
+}
+
+
+func TestExtractSNI(t *testing.T) {
+	pkt := makeClientHello("fragment-logging.test.org", true)
+	sni := ExtractSNI(pkt)
+	if sni != "fragment-logging.test.org" {
+		t.Fatalf("ExtractSNI got %q, want %q", sni, "fragment-logging.test.org")
+	}
+
+	pktNoSNI := makeClientHello("", false)
+	sniNo := ExtractSNI(pktNoSNI)
+	if sniNo != "" {
+		t.Fatalf("ExtractSNI for no-SNI got %q, want empty", sniNo)
+	}
+
+	if ExtractSNI(nil) != "" {
+		t.Fatal("ExtractSNI(nil) should be empty")
+	}
+}
diff --git a/component/fragment/stats.go b/component/fragment/stats.go
new file mode 100644
index 0000000..fafd1a0
--- /dev/null
+++ b/component/fragment/stats.go
@@ -0,0 +1,111 @@
+// Copyright (C) 2026 mateika8814 (https://github.com/mateika8814)
+// This file is part of allah-verge (fork of Clash Verge Rev / mihomo).
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+
+package fragment
+
+import (
+	"sync"
+	"time"
+)
+
+// Stats holds real-time counters and diagnostics metrics for TLS fragmentation.
+type Stats struct {
+	TotalClientHello    int64            `json:"total_client_hello"`
+	SuccessfulFragments int64            `json:"successful_fragments"`
+	FailedFragments     int64            `json:"failed_fragments"`
+	Timeouts            int64            `json:"timeouts"`
+	BypassedNonTLS      int64            `json:"bypassed_non_tls"`
+	ModeDistribution    map[string]int64 `json:"mode_distribution"`
+	LastError           string           `json:"last_error"`
+	LastErrorTime       int64            `json:"last_error_time"`
+	LastEventTime       int64            `json:"last_event_time"`
+}
+
+type statsManager struct {
+	mu    sync.RWMutex
+	stats Stats
+}
+
+var globalStats = &statsManager{
+	stats: Stats{
+		ModeDistribution: make(map[string]int64),
+	},
+}
+
+// GetGlobalStats returns a copy of current fragment statistics.
+func GetGlobalStats() Stats {
+	globalStats.mu.RLock()
+	defer globalStats.mu.RUnlock()
+
+	res := globalStats.stats
+	res.ModeDistribution = make(map[string]int64, len(globalStats.stats.ModeDistribution))
+	for k, v := range globalStats.stats.ModeDistribution {
+		res.ModeDistribution[k] = v
+	}
+	return res
+}
+
+// ResetGlobalStats clears all counters.
+func ResetGlobalStats() {
+	globalStats.mu.Lock()
+	defer globalStats.mu.Unlock()
+
+	globalStats.stats = Stats{
+		ModeDistribution: make(map[string]int64),
+	}
+}
+
+// RecordClientHelloDetected records a detected TLS ClientHello event.
+func RecordClientHelloDetected(mode string) {
+	globalStats.mu.Lock()
+	defer globalStats.mu.Unlock()
+
+	globalStats.stats.TotalClientHello++
+	globalStats.stats.LastEventTime = time.Now().Unix()
+}
+
+// RecordFragmentationSuccess records an executed fragmentation.
+func RecordFragmentationSuccess(mode string) {
+	globalStats.mu.Lock()
+	defer globalStats.mu.Unlock()
+
+	globalStats.stats.SuccessfulFragments++
+	globalStats.stats.ModeDistribution[mode]++
+	globalStats.stats.LastEventTime = time.Now().Unix()
+}
+
+// RecordFragmentationError records a fragmentation failure.
+func RecordFragmentationError(mode string, err error) {
+	globalStats.mu.Lock()
+	defer globalStats.mu.Unlock()
+
+	globalStats.stats.FailedFragments++
+	if err != nil {
+		globalStats.stats.LastError = err.Error()
+		globalStats.stats.LastErrorTime = time.Now().Unix()
+	}
+	globalStats.stats.LastEventTime = time.Now().Unix()
+}
+
+// RecordBufferTimeout records a buffering timeout event.
+func RecordBufferTimeout() {
+	globalStats.mu.Lock()
+	defer globalStats.mu.Unlock()
+
+	globalStats.stats.Timeouts++
+	globalStats.stats.LastEventTime = time.Now().Unix()
+}
+
+// RecordNonTLSBypass records non-TLS traffic forwarded without fragmentation.
+func RecordNonTLSBypass() {
+	globalStats.mu.Lock()
+	defer globalStats.mu.Unlock()
+
+	globalStats.stats.BypassedNonTLS++
+	globalStats.stats.LastEventTime = time.Now().Unix()
+}
