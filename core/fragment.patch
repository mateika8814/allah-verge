+++ b/component/fragment/sni.go
@@ -0,0 +1,115 @@
+// Copyright (C) 2026 mateika8814 (https://github.com/mateika8814)
+// This file is part of allah-verge (fork of Clash Verge Rev / mihomo).
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+
+package fragment
+
+import (
+	"encoding/binary"
+)
+
+// FindSNIOffset parses a TLS ClientHello record to find the exact byte offset
+// and length of the server_name host in the record buffer.
+// It returns (offset, length, true) if found, or (0, 0, false) if not found or on parse failure.
+func FindSNIOffset(b []byte) (offset int, length int, ok bool) {
+	// A minimum TLS ClientHello record is at least 44 bytes
+	if len(b) < 44 {
+		return 0, 0, false
+	}
+
+	// Must be a TLS Handshake record (0x16) with major version 0x03
+	if b[0] != 0x16 || b[1] != 0x03 {
+		return 0, 0, false
+	}
+
+	recLen := int(binary.BigEndian.Uint16(b[3:5]))
+	if len(b) < 5+recLen {
+		return 0, 0, false
+	}
+
+	// Handshake Message starts at offset 5
+	// Handshake type: 0x01 = ClientHello
+	if b[5] != 0x01 {
+		return 0, 0, false
+	}
+
+	// Handshake length (3 bytes)
+	hsLen := int(b[6])<<16 | int(b[7])<<8 | int(b[8])
+	if hsLen < 38 || len(b) < 5+4+hsLen {
+		return 0, 0, false
+	}
+
+	// ClientVersion (2 bytes) + Random (32 bytes) = 34 bytes
+	// Offset of SessionID length: 5 + 4 + 34 = 43
+	p := 43
+	if len(b) < p+1 {
+		return 0, 0, false
+	}
+	sidLen := int(b[p])
+	p += 1 + sidLen
+
+	// CipherSuites: 2 bytes length + data
+	if len(b) < p+2 {
+		return 0, 0, false
+	}
+	csLen := int(binary.BigEndian.Uint16(b[p : p+2]))
+	p += 2 + csLen
+
+	// CompressionMethods: 1 byte length + data
+	if len(b) < p+1 {
+		return 0, 0, false
+	}
+	cmLen := int(b[p])
+	p += 1 + cmLen
+
+	// Extensions: 2 bytes length + extensions
+	if len(b) < p+2 {
+		return 0, 0, false
+	}
+	extsLen := int(binary.BigEndian.Uint16(b[p : p+2]))
+	p += 2
+	endExts := p + extsLen
+	if endExts > len(b) {
+		endExts = len(b)
+	}
+
+	// Traverse extensions
+	for p+4 <= endExts {
+		extType := binary.BigEndian.Uint16(b[p : p+2])
+		extLen := int(binary.BigEndian.Uint16(b[p+2 : p+4]))
+		p += 4
+
+		if p+extLen > endExts {
+			return 0, 0, false
+		}
+
+		if extType == 0x0000 { // Server Name Indication (SNI)
+			sniData := b[p : p+extLen]
+			// SNI list length (2 bytes) + name type (1 byte) + name length (2 bytes)
+			if len(sniData) >= 5 && sniData[2] == 0x00 { // 0x00 = host_name
+				hostLen := int(binary.BigEndian.Uint16(sniData[3:5]))
+				if hostLen > 0 && len(sniData) >= 5+hostLen {
+					hostOffset := p + 5
+					return hostOffset, hostLen, true
+				}
+			}
+		}
+
+		p += extLen
+	}
+
+	return 0, 0, false
+}
+
+// ExtractSNI extracts the server_name (SNI) string from a TLS ClientHello record if present.
+func ExtractSNI(b []byte) string {
+	offset, length, ok := FindSNIOffset(b)
+	if ok && offset >= 0 && offset+length <= len(b) {
+		return string(b[offset : offset+length])
+	}
+	return ""
+}
diff --git a/component/fragment/sni_test.go b/component/fragment/sni_test.go
new file mode 100644
index 0000000..53423ca
--- /dev/null
+++ b/component/fragment/sni_test.go
@@ -0,0 +1,135 @@
+// Copyright (C) 2026 mateika8814 (https://github.com/mateika8814)
+// This file is part of allah-verge (fork of Clash Verge Rev / mihomo).
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+
+package fragment
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+// Helper to construct a synthetic but RFC-compliant TLS ClientHello
+func makeClientHello(sni string, includeSNI bool) []byte {
+	var exts []byte
+	if includeSNI {
+		sniBytes := []byte(sni)
+		sniExt := []byte{0x00, 0x00} // extension type 0 = server_name
+		sniExt = binary.BigEndian.AppendUint16(sniExt, uint16(len(sniBytes)+5))
+		sniExt = binary.BigEndian.AppendUint16(sniExt, uint16(len(sniBytes)+3))
+		sniExt = append(sniExt, 0x00) // name_type 0 = host_name
+		sniExt = binary.BigEndian.AppendUint16(sniExt, uint16(len(sniBytes)))
+		sniExt = append(sniExt, sniBytes...)
+		exts = sniExt
+	} else {
+		// ALPN or dummy extension (e.g. type 0x0010)
+		dummy := []byte{0x00, 0x10, 0x00, 0x02, 0x01, 0x02}
+		exts = dummy
+	}
+
+	hsPayload := []byte{0x03, 0x03}                       // ClientVersion TLS 1.2
+	hsPayload = append(hsPayload, make([]byte, 32)...)    // Random (32 bytes)
+	hsPayload = append(hsPayload, 0x00)                   // SessionID length 0
+	hsPayload = append(hsPayload, 0x00, 0x02, 0x00, 0x9c) // CipherSuites: 1 suite (0x009c)
+	hsPayload = append(hsPayload, 0x01, 0x00)             // CompressionMethods: 1 method (null)
+	hsPayload = binary.BigEndian.AppendUint16(hsPayload, uint16(len(exts)))
+	hsPayload = append(hsPayload, exts...)
+
+	hs := []byte{0x01} // HandshakeType ClientHello
+	hsLen := len(hsPayload)
+	hs = append(hs, byte(hsLen>>16), byte(hsLen>>8), byte(hsLen))
+	hs = append(hs, hsPayload...)
+
+	rec := []byte{0x16, 0x03, 0x01} // Record header: Handshake, TLS 1.0 legacy
+	rec = binary.BigEndian.AppendUint16(rec, uint16(len(hs)))
+	rec = append(rec, hs...)
+	return rec
+}
+
+func TestFindSNIOffset_Valid(t *testing.T) {
+	testDomains := []string{
+		"example.com",
+		"subdomain.target.org",
+		"a.b.c.d.ru",
+		"very-long-domain-name-for-testing-purposes-12345.net",
+	}
+
+	for _, domain := range testDomains {
+		pkt := makeClientHello(domain, true)
+		offset, length, ok := FindSNIOffset(pkt)
+		if !ok {
+			t.Fatalf("Expected SNI to be found for domain %s", domain)
+		}
+		if length != len(domain) {
+			t.Fatalf("Expected length %d, got %d", len(domain), length)
+		}
+		extracted := string(pkt[offset : offset+length])
+		if extracted != domain {
+			t.Fatalf("Extracted domain %s != expected %s", extracted, domain)
+		}
+	}
+}
+
+func TestFindSNIOffset_WithoutSNI(t *testing.T) {
+	pkt := makeClientHello("", false)
+	_, _, ok := FindSNIOffset(pkt)
+	if ok {
+		t.Fatalf("Expected FindSNIOffset to return ok=false when SNI is absent")
+	}
+}
+
+func TestFindSNIOffset_Truncated(t *testing.T) {
+	pkt := makeClientHello("example.com", true)
+
+	// Test cutting at every single byte boundary
+	for i := 0; i < len(pkt)-1; i++ {
+		truncated := pkt[:i]
+		_, _, ok := FindSNIOffset(truncated)
+		if ok {
+			t.Fatalf("Expected ok=false for truncated packet at len %d (original %d)", i, len(pkt))
+		}
+	}
+}
+
+func TestFindSNIOffset_Garbage(t *testing.T) {
+	garbageCases := [][]byte{
+		nil,
+		{},
+		{0x00, 0x01, 0x02},
+		[]byte("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n"),
+		[]byte("SSH-2.0-OpenSSH_8.9p1\r\n"),
+		make([]byte, 100), // all zeros
+		{0x16, 0x03, 0x01, 0xFF, 0xFF}, // fake record header with truncated payload
+		{0x16, 0x03, 0x01, 0x00, 0x05, 0x02, 0x00, 0x00, 0x01, 0x00}, // Handshake type 2 (ServerHello, not ClientHello)
+	}
+
+	for idx, g := range garbageCases {
+		_, _, ok := FindSNIOffset(g)
+		if ok {
+			t.Fatalf("Expected ok=false on garbage case %d", idx)
+		}
+	}
+}
+
+
+func TestExtractSNI(t *testing.T) {
+	pkt := makeClientHello("fragment-logging.test.org", true)
+	sni := ExtractSNI(pkt)
+	if sni != "fragment-logging.test.org" {
+		t.Fatalf("ExtractSNI got %q, want %q", sni, "fragment-logging.test.org")
+	}
+
+	pktNoSNI := makeClientHello("", false)
+	sniNo := ExtractSNI(pktNoSNI)
+	if sniNo != "" {
+		t.Fatalf("ExtractSNI for no-SNI got %q, want empty", sniNo)
+	}
+
+	if ExtractSNI(nil) != "" {
+		t.Fatal("ExtractSNI(nil) should be empty")
+	}
+}
